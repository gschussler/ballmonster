<!DOCTYPE html>
<html lang="en" class="preload">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BALL MONSTER</title>
  <meta name="description" content="A Pokémon type calculator with support for all generations.">
  <meta name="color-scheme" content="dark light">
  <meta name="darkreader-lock">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <style nonce="{{.Nonce}}">
    html.preload {
      opacity: 0;
    }
  </style>
  <link rel="stylesheet" href="/{{.Assets.CSS}}">
  <link rel="icon" href="/{{.Assets.FaviconICO}}" sizes="32x32">
  <link rel="icon" type="image/svg+xml" href="/{{.Assets.IconSVG}}">
  <link rel="apple-touch-icon" href="/{{.Assets.AppleTouchIcon}}">
  <script src="/{{.Assets.HtmxJS}}"></script>
  <script src="/{{.Assets.PreloadJS}}" defer></script>
  <script src="/{{.Assets.FuseJS}}" defer></script>
</head>
<body hx-ext="preload">
  <header>
    <div class="banner-wrapper">
      <div class="banner" role="img" aria-label="ball.monster logo">
        <img src="/{{.Assets.BallSVG}}" alt="" aria-hidden="true"/>
        <img src="/{{.Assets.BallBmSVG}}" alt="" aria-hidden="true"/>
        <img src="/{{.Assets.MonsterSVG}}" fetchpriority="high" alt="" aria-hidden="true"/>
      </div>
    </div>
    <p>...a Pokémon type calculator.</p>
  </header>
  <nav hx-boost="true">
    <div class="nav-links">
      <a href="/offense" id="offense" hx-get="/pages/offense.html" hx-target="#content" hx-swap="innerHTML" class="page-link{{if eq .Page "offense"}} active{{end}}" aria-label="Offense" preload="mouseover" hx-push-url="true">Offense</a>
      <a href="/defense" id="defense" hx-get="/pages/defense.html" hx-target="#content" hx-swap="innerHTML" class="page-link{{if eq .Page "defense"}} active{{end}}" aria-label="Defense" preload="mouseover" hx-push-url="true">Defense</a>
      <a href="/more" id="more" hx-get="/pages/more.html" hx-target="#content" hx-swap="innerHTML" class="page-link{{if eq .Page "more"}} active{{end}}" aria-label="More" preload="mouseover" hx-push-url="true">More</a>
    </div>
    <div class="gen-display">
      <h4>Current Gen: </h4>
      <span id="gen"></span>
    </div>
  </nav>
  <div id="search-layer">
    <div id="search-backdrop" class="search-backdrop hidden"></div>
    <div id="search-container" class="search-container">
      <svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24"><g><path d="M23.0875,22.0875 17.6,16.6C19,15 20,13.2 20,11 20,6 16,2 11,2 6,2 2,6 2,11c0,5 4,9 9,9 2.2,0 4,-1 5.6,-2.3l5.2875,5.2875c1.481298,1.007685 1.735945,-0.161979 1.2,-0.9zM3.5,11c0,-4.1 3.4,-7.5 7.5,-7.5 4.1,0 7.5,3.4 7.5,7.5 0,4.1 -3.4,7.5 -7.5,7.5 -4.1,0 -7.5,-3.4 -7.5,-7.5z"></path></g></svg>
      <input
        type="search"
        id="search"
        name="search"
        autocomplete="off"
        maxlength="30"
      />
      <div id="search-results" class="search-results hidden"></div>
    </div>
  </div>

  <div id="spinner" class="hidden" aria-label="Loading site...">
    <svg width="60" height="60" viewBox="0 0 50 50">
      <circle
        class="spinner-circle"
        cx="25"
        cy="25"
        r="20"
        fill="none"
        stroke="#cf980f"
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray="60 120"
      >
    </svg>
  </div>

  <main id="content" class="preload" data-mode="{{.Page}}">
    {{.Fragment}}
  </main>
  <script nonce="{{.Nonce}}">
    window.__INIT_STATE__ = {{.State}};
  </script>
  <script type="module" src="/{{.Assets.ScriptsJS}}" defer></script>
  </body>
</html>